# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=personal_finance

# App Configuration
NODE_ENV=development

# AI Configuration
AI_PROVIDER=gemini
